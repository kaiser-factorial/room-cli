{
  "name": "@local/room",
  "version": "0.0.1",
  "description": "A terminal room for one human and several coding agents, over the Agent Client Protocol",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "room": "./dist/packages/room/bin/room.js"
  },
  "files": [
    "dist/packages/room/bin",
    "dist/packages/room/src",
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "dev": "tsx bin/room.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.81.2",
    "@agentclientprotocol/codex-acp": "^1.13.1",
    "@agentclientprotocol/sdk": "^1.5.0",
    "commander": "^14.0.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "smol-toml": "^1.4.0"
  },
  "optionalDependencies": {
    "antigravity-acp": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^3.2.0"
  }
}
