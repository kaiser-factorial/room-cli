{
  "name": "@local/room",
  "version": "0.0.1",
  "description": "A terminal room for one human and several coding agents, over the Agent Client Protocol",
  "type": "module",
  "private": true,
  "bin": {
    "room": "./dist/packages/room/bin/room.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx bin/room.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.0",
    "commander": "^14.0.0",
    "smol-toml": "^1.4.0"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.81.2",
    "@agentclientprotocol/codex-acp": "^1.13.1",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  },
  "optionalDependencies": {
    "antigravity-acp": "^1.1.0"
  }
}
